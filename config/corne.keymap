#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi> // requires auto-layer module
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/42.h"
#include "keys_sv_mac.h"  // OS input source: macOS "Swedish - Pro"

// To flash new firmware:
// 1. push to GH action
// 2. download firmware and unzip
// 3. plug in one keyboard half at a time
// 4. Put it in bootloader mode (double click reset-button)
// 5. drag firmware to attached keyboard-"drive"
// 6. In ZMK Studio: "Restore stock settings", otherwise saved Studio edits override this file

#define DEF 0  // layer shortcuts, must match order in which they are defined below
#define NAV 1
#define SYM 2
#define NUM 3
#define SYS 4

#define XXX &none
#define ___ &trans

/* Global settings */

#define QUICK_TAP_MS 175

&sk {  // sticky-key config
    release-after-ms = <900>;  // release after 0.9s
    quick-release;             // no double capitalization when rolling keys
};

&sl {  // sticky-layer config
    ignore-modifiers;          // allow chording sticky mods & layers
};

&lt {  // layer-tap config
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
};

&caps_word {  // keep caps-word going through Swedish _ and -
    continue-list = <SV_UNDER SV_MINUS BSPC DEL>;
};

&num_word {  // Swedish codes; = / ( ) are shifted number keys and continue anyway
    continue-list = <BSPC DEL DOT COMMA SV_PLUS SV_MINUS SV_STAR>;
};

/* Homerow mods */

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4  // right hand
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                      // thumbs

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
    ZMK_HOLD_TAP(NAME, \
        flavor = "balanced"; \
        tapping-term-ms = <280>; \
        quick-tap-ms = <QUICK_TAP_MS>; \
        require-prior-idle-ms = <150>; \
        bindings = <HOLD>, <TAP>; \
        hold-trigger-key-positions = <TRIGGER_POS>; \
        hold-trigger-on-release; \
    )
MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS)  // left-hand HRMs
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS)  // right-hand HRMs

/* Nav cluster (macOS) */

// long-tap action on hold, short-tap action on all interrupts
&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <220>;
    quick-tap-ms = <220>;
    hold-trigger-key-positions = <0>;
};

#define NAV_LEFT  &mt LG(LEFT)  LEFT   // tap: left  | long-tap: beginning of line
#define NAV_RIGHT &mt LG(RIGHT) RIGHT  // tap: right | long-tap: end       of line
#define NAV_UP    &mt LG(UP)    UP     // tap: up    | long-tap: beginning of document
#define NAV_DOWN  &mt LG(DOWN)  DOWN   // tap: down  | long-tap: end       of document
#define WORD_L    &kp LA(LEFT)         // previous word
#define WORD_R    &kp LA(RIGHT)        // next word
#define DEL_WORD  &kp LA(BSPC)         // delete word backward
#define DEL_WORDF &kp LA(DEL)          // delete word forward

/* Clipboard (macOS) */

#define UNDO  &kp LG(Z)
#define CUT   &kp LG(X)
#define COPY  &kp LG(C)
#define PASTE &kp LG(V)
#define REDO  &kp LG(LS(Z))

/* Num-word */

// tap: num-word | double-tap: sticky num-layer | hold: num-layer
#define SMART_NUM &smart_num NUM 0
ZMK_HOLD_TAP(smart_num,
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
    bindings = <&mo>, <&num_dance>;
)
ZMK_TAP_DANCE(num_dance,
    tapping-term-ms = <200>;
    bindings = <&num_word NUM>, <&sl NUM>;  // reverse this for sticky-num on single tap
)

/* Punctuation with custom shift */

#define SIMPLE_MORPH(NAME, MOD, BINDING1, BINDING2) \
    ZMK_MOD_MORPH(NAME, \
        mods = <(MOD_L ## MOD|MOD_R ## MOD)>; \
        bindings = <BINDING1>, <BINDING2>; \
    )

SIMPLE_MORPH(comma_q,   SFT, &kp COMMA,   &kp SV_QMARK)  // ,  shift: ?
SIMPLE_MORPH(dot_excl,  SFT, &kp DOT,     &kp SV_EXCL)   // .  shift: !
SIMPLE_MORPH(semi_col,  SFT, &kp SV_SEMI, &kp SV_COLON)  // ;  shift: :
SIMPLE_MORPH(quotes,    SFT, &kp SV_SQT,  &kp SV_DQT)    // '  shift: "

// ~ is a dead key on Swedish - Pro, so send it followed by space
ZMK_MACRO(sv_tilde,
    wait-ms = <0>;
    tap-ms = <10>;
    bindings = <&macro_tap &kp SV_TILDE_DEAD &kp SPACE>;
)

/* macOS function-row actions */

#define MISSION   &kp LC(UP)          // Mission Control
#define SPOTLIGHT &kp LG(SPACE)
#define SCRNSHOT  &kp LG(LS(N5))      // screenshot / recording tool
#define LOCK      &kp LC(LG(Q))       // lock screen

/* Combos: å ä ö (vertical pairs, right hand) and caps-word */

ZMK_COMBO(ao,       &kp SV_AO,  RT2 RM2, DEF)  // o + a       -> å
ZMK_COMBO(ae,       &kp SV_AE,  RM2 RB2, DEF)  // a + '       -> ä
ZMK_COMBO(oe,       &kp SV_OE,  RM3 RB3, DEF)  // e + ;       -> ö
ZMK_COMBO(capsword, &caps_word, LM0 RM0, DEF)  // g + p       -> caps word

/* Holding Nav (Space) + Sym (Enter) together opens the system layer */

ZMK_CONDITIONAL_LAYER(sys, NAV SYM, SYS)

/* Layers - Gallium */

ZMK_LAYER(def,
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
         XXX          &kp B         &kp L         &kp D         &kp C         &kp V             &kp J         &kp Y         &kp O         &kp U        &comma_q         XXX
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
         XXX      &hml LCTRL N   &hml LALT R   &hml LGUI T   &hml LSHFT S     &kp G             &kp P     &hmr RSHFT H   &hmr RGUI A   &hmr RALT E   &hmr RCTRL I       XXX
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
         XXX       &mt LG(Z) X   &mt LG(X) Q   &mt LG(C) M      &kp W      &mt LG(V) Z          &kp K         &kp F        &quotes      &semi_col     &dot_excl        XXX
// ╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤─────────────┤   ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                                &kp ESC     &lt NAV SPACE    &kp TAB         &lt SYM RET     &kp BSPC      SMART_NUM
//                                           ╰─────────────┴──── ────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(nav,
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        ___           ___           ___           ___           ___           ___           DEL_WORD      &kp PG_DN     &kp PG_UP     DEL_WORDF        ___           ___
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        ___        &sk LCTRL      &sk LALT      &sk LGUI     &sk LSHFT        ___           NAV_LEFT      NAV_DOWN       NAV_UP      NAV_RIGHT        ___           ___
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        ___           UNDO          CUT           COPY          REDO         PASTE           WORD_L         ___           ___          WORD_R         ___           ___
// ╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤─────────────┤   ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                                  ___           ___           ___             ___           ___           ___
//                                           ╰─────────────┴──── ────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(sym,
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        ___       &kp SV_GRAVE   &kp SV_AT    &kp SV_HASH   &kp SV_DLLR    &sv_tilde      &kp SV_PIPE   &kp SV_LBKT   &kp SV_RBKT   &kp SV_AMPS   &kp SV_QMARK      ___
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        ___       &kp SV_STAR    &kp SV_EQL   &kp SV_MINUS   &kp SV_GT    &kp SV_FSLH     &kp SV_SEMI   &kp SV_COLON  &kp SV_LPAR   &kp SV_RPAR    &kp SV_SQT       ___
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        ___       &kp SV_CARET  &kp SV_PLUS   &kp SV_LBRC   &kp SV_RBRC   &kp SV_BSLH     &kp SV_UNDER   &kp SV_LT    &kp SV_PRCT   &kp SV_EXCL   &kp SV_EURO       ___
// ╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤─────────────┤   ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                                  ___           ___           ___             ___           ___           ___
//                                           ╰─────────────┴──── ────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(num,
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
        ___           ___           ___           ___           ___           ___             ___          &kp N7        &kp N8        &kp N9         ___           ___
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        ___       &kp SV_STAR    &kp SV_EQL   &kp SV_MINUS    &kp DOT     &kp SV_FSLH         ___          &kp N4        &kp N5        &kp N6         ___           ___
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
        ___           ___       &kp SV_PLUS    &kp COMMA    &kp SV_COLON      ___            &kp N0        &kp N1        &kp N2        &kp N3         ___           ___
// ╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤─────────────┤   ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                                  ___           ___           ___           &kp RET         ___         &kp DOT
//                                           ╰─────────────┴──── ────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(sys,
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
         ___      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3       ___              SCRNSHOT    &kp C_BRI_DN  &kp C_BRI_UP     MISSION      SPOTLIGHT        ___
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
         ___           ___           ___           ___           ___           ___               ___        &kp C_PREV     &kp C_PP     &kp C_NEXT       LOCK           ___
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
         ___       &bt BT_CLR   &studio_unlock     ___           ___       &bootloader         &bootloader  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP       ___           ___
// ╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤─────────────┤   ├─────────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────────────╯
                                                   ___           ___           ___               ___           ___           ___
//                                           ╰─────────────┴──── ────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
)
